{
  "name": "birdbird",
  "compatibility_date": "2026-01-16",
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Ensure /media/* always reaches the Worker rather than the asset router
    "run_worker_first": ["/media/*"]
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "birdbird-highlights" }
  ]
}
